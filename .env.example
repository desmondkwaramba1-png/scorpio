PORT=4000
# Set to production on the live server. Secure cookies depend on it, and the
# demo seed refuses to run when it is set.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PRODUCT_UPLOAD_ORIGIN=https://scorpio-api.fly.dev

# Where the database and local uploads live. Leave blank for local dev.
DATA_DIR=

# The whole access control for the admin app. Use a long random value, for
# example the output of: openssl rand -base64 48
ADMIN_KEY=

# Platform cut per paid order, in percent. Defaults to 8.
PLATFORM_FEE_PERCENT=8

# Proxies in front of the app. 1 is Fly alone. If production logs show every
# visitor with a Vercel address, set this to 2.
TRUST_PROXY_HOPS=1

# Session cookie
SESSION_COOKIE_NAME=zimselar_session
SESSION_TTL_DAYS=30

# Email verification and password reset.
EMAIL_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=15

# Resend (resend.com) — real email delivery for verification and password
# reset. Free tier: 100 emails/day, no card required. Sign up, grab the API
# key from the dashboard. Without a verified domain, Resend's free tier only
# delivers to the email address you signed up with (its "sandbox" mode) —
# verify a domain in the Resend dashboard to send to arbitrary buyers/
# creators. Leave RESEND_API_KEY blank to fall back to console-logging
# instead of sending (useful for local dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=SCORPIO <onboarding@resend.dev>

# Google OAuth — from Google Cloud Console (Credentials). The redirect URI
# below must be added under "Authorized redirect URIs" on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Facebook OAuth — from developers.facebook.com (Settings > Basic).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# Dischub payment gateway (EcoCash). DISCHUB_RECIPIENT must be the email that
# created your Dischub merchant account. There is no test-mode switch here:
# with a live key, every order sends a real EcoCash prompt. Payments are
# confirmed by polling Dischub, so no webhook setup is needed.
DISCHUB_API_KEY=
DISCHUB_RECIPIENT=
DISCHUB_BASE_URL=https://dischub.co.zw

# Cloudflare R2 (S3-compatible object storage) — all uploads (covers,
# avatars, reels, product files, service deliveries) go here instead of
# this server's own disk. Create a bucket + an API token with Object Read
# & Write in the Cloudflare dashboard (R2 > Manage API Tokens) for
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY. R2_ACCOUNT_ID is shown in the R2
# dashboard's own URL/sidebar. R2_PUBLIC_URL is wherever the bucket is
# actually reachable at — either the default <bucket>.r2.dev subdomain
# (enable "public access" on the bucket first) or a custom domain mapped
# to it. Leave all of these blank and uploads fail with a clear 503 rather
# than silently pretending to work.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
