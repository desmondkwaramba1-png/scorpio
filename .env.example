PORT=4000
FRONTEND_URL=http://localhost:5173

# Session cookie
SESSION_COOKIE_NAME=zimselar_session
SESSION_TTL_DAYS=30

# Email verification and password reset.
EMAIL_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=15

# Resend (resend.com) — real email delivery for verification and password
# reset. Free tier: 100 emails/day, no card required. Sign up, grab the API
# key from the dashboard. Without a verified domain, Resend's free tier only
# delivers to the email address you signed up with (its "sandbox" mode) —
# verify a domain in the Resend dashboard to send to arbitrary buyers/
# creators. Leave RESEND_API_KEY blank to fall back to console-logging
# instead of sending (useful for local dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=SCORPIO <onboarding@resend.dev>

# Google OAuth — from Google Cloud Console (Credentials). The redirect URI
# below must be added under "Authorized redirect URIs" on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Facebook OAuth — from developers.facebook.com (Settings > Basic).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# Dischub payment gateway (EcoCash). mode=test uses Dischub's test
# environment. DISCHUB_RECIPIENT must be the email that created your
# Dischub merchant account. DISCHUB_CALLBACK_URL must be https:// or omitted
# entirely — Dischub rejects the whole order otherwise, so leave it blank on
# localhost and rely on the redirect + status-poll flow instead.
DISCHUB_API_KEY=
DISCHUB_RECIPIENT=
DISCHUB_MODE=test
DISCHUB_BASE_URL=https://dischub.co.zw
DISCHUB_CALLBACK_URL=
